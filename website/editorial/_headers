# Every file served directly (the Worker sets its own headers on the page,
# admin and API).
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin

# Photographs rarely change: let browsers keep them for 30 days (and use a
# stale copy while re-checking for a day after that).
/photos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/medium/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/thumbs/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
# Icons: a day, so a new one shows up soon.
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-*
  Cache-Control: public, max-age=86400
