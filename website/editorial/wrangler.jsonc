// Cloudflare Worker config. Deploy with:
//   npx wrangler deploy --config website/editorial/wrangler.jsonc
{
  "name": "francephotography",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Unknown addresses get the site's own 404 page.
    "not_found_handling": "404-page",
    // Only these run the Worker (they count toward the 100,000 free Worker
    // requests a day); every other file is served directly, free and
    // unlimited. Photographs uploaded in /admin (u-…) live in KV.
    "run_worker_first": [
      "/",
      "/index.html",
      "/data.js",
      "/api/*",
      "/admin",
      "/admin/*",
      "/robots.txt",
      "/sitemap.xml",
      "/photos/*/u-*",
      "/medium/*/u-*",
      "/thumbs/*/u-*"
    ]
  },
  "vars": {
    // Where enquiries are emailed, and the address they come from.
    "ENQUIRY_TO": "work.photosbysundar@gmail.com",
    "MAIL_FROM": "enquiries@photosbysundar.com",
    // The address used in emailed sign-in links (never taken from a request).
    "SITE_URL": "https://photosbysundar.com"
  },
  // Cloudflare Email: sends only to ENQUIRY_TO, which must be a verified
  // destination address in the domain's Email Routing.
  "send_email": [{ "name": "MAILER", "destination_address": "work.photosbysundar@gmail.com" }],
  // Content edited in /admin, uploaded photographs, enquiries and rate limits.
  // /admin also needs the secret ADMIN_PASSWORD (set in the Cloudflare
  // dashboard: Worker > Settings > Variables and Secrets).
  "kv_namespaces": [{ "binding": "CONTENT", "id": "55a5c819b7594469a253133f3edaccd5" }],
  "observability": { "enabled": true }
}
